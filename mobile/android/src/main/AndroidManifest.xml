<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The layout is drawn with OpenGL ES 3.0 (canvas/FramePainter.kt). -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <application android:icon="@drawable/openmaker" android:label="OpenMaker Go" android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- The view model keeps an open file across a recreated activity; the
             activity still handles every change it can itself, so that the
             canvas keeps its OpenGL context and the keyboard its field. The
             canvas always takes text, so the touch keyboard is kept hidden
             when the window gets the focus back: it shows only for a field
             (leaving the foreground saves the record, which ends the edit). -->
        <activity android:name=".MainActivity" android:exported="true"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|screenLayout|fontScale|uiMode|orientation|density|screenSize|smallestScreenSize|layoutDirection|colorMode|fontWeightAdjustment|grammaticalGender"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
